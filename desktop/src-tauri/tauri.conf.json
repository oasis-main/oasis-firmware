{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oasis Studio",
  "version": "0.1.0",
  "identifier": "io.oasis-x.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oasis Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Design, simulate, flash, and command hobby hardware",
    "longDescription": "Oasis Studio turns a device.yaml into firmware, finds connected boards, and keeps an owned-device list and an action log. Open source under Apache-2.0.",
    "licenseFile": "../../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": { "depends": ["libudev1"] },
      "rpm": { "depends": ["systemd-libs"] }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
